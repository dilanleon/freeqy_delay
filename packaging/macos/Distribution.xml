<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>FREEQY DELAY</title>
    <options customize="always" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="clap"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="VST3" start_selected="true"
            enabled="!choices['vst3'].selected || choices['clap'].selected || choices['au'].selected">
        <pkg-ref id="com.dleon.freeqydelay.pkg.vst3"/>
    </choice>
    <choice id="clap" title="CLAP" start_selected="true"
            enabled="!choices['clap'].selected || choices['vst3'].selected || choices['au'].selected">
        <pkg-ref id="com.dleon.freeqydelay.pkg.clap"/>
    </choice>
    <choice id="au" title="Audio Units (AU)" start_selected="true"
            enabled="!choices['au'].selected || choices['vst3'].selected || choices['clap'].selected">
        <pkg-ref id="com.dleon.freeqydelay.pkg.au"/>
    </choice>
    <pkg-ref id="com.dleon.freeqydelay.pkg.vst3">vst3.pkg</pkg-ref>
    <pkg-ref id="com.dleon.freeqydelay.pkg.clap">clap.pkg</pkg-ref>
    <pkg-ref id="com.dleon.freeqydelay.pkg.au">au.pkg</pkg-ref>
</installer-gui-script>
